---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  siteName?: string;
}

const {
  title,
  description,
  image = '/og-card.svg',
  canonicalUrl,
  siteName = 'Fabián Jeldes — Software, Web y Datos',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://oferta-medios.fabian-jeldes.workers.dev';
const canonical = canonicalUrl ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : new URL(Astro.url.pathname, siteUrl).href);
const ogImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Google Fonts: Manrope + DM Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <script>
      // Revela cada bloque .reveal cuando entra en pantalla, como en Revista ZUN.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  /* Sistema de diseño editorial ZUN (Manrope + DM Mono, papel blanco, acento rojo #FF262A) */
  :root {
    /* Paleta */
    --bg: #ffffff;
    --blanco-cielo: #f9faff;
    --celeste: #f4f6ff;
    --gris-cielo: #eceff4;
    --borde-card: #8f96b5;
    --rojo: #ff262a;
    --text: #1f1f1f;
    --negro: #111111;
    --gris: #565656;
    --line: rgba(0, 0, 0, 0.1);

    /* Ritmo vertical (Móvil por defecto) */
    --gap-s: 20px;
    --gap-m: 24px;
    --gap-l: 48px;

    /* Tipografía */
    --font-display: 'Manrope', sans-serif;
    --font-body: 'Manrope', sans-serif;
    --font-mono: 'DM Mono', monospace;

    /* Layout */
    --container-max: 1120px;
    --container-pad: clamp(16px, 4vw, 48px);
  }

  @media (min-width: 1024px) {
    :root {
      --gap-s: 24px;
      --gap-m: 40px;
      --gap-l: 80px;
    }
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    text-rendering: geometricPrecision;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    margin-top: 0;
    color: var(--text);
    text-wrap: balance;
  }

  h1 {
    font-size: 3.625rem;
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  h2 {
    font-size: 3rem;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  h3 {
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  h4 {
    font-size: 1.125rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  p,
  li {
    font-size: 1rem;
    line-height: 1.55;
  }

  p {
    margin: 0 0 1.2rem;
  }

  @media (min-width: 1024px) {
    p,
    li {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.75rem;
    }

    h2 {
      font-size: 2.25rem;
    }

    h3 {
      font-size: 1.25rem;
    }

    h4 {
      font-size: 1rem;
    }
  }

  a {
    color: inherit;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--rojo);
    outline-offset: 2px;
  }

  /* Etiqueta monoespaciada (Kicker / H5 / H6) */
  .label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.08;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gris);
    margin: 0 0 var(--gap-s);
  }

  @media (max-width: 768px) {
    .label {
      font-size: 0.75rem;
    }
  }

  /* Píldora de navegación o acción secundaria */
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 20px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    border: 1px solid var(--text);
    border-radius: 100px;
    background-color: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .pill--filled {
    background-color: var(--text);
    color: var(--bg);
  }

  .pill--light {
    color: #ffffff;
    border-color: #ffffff;
  }

  .pill:hover,
  .pill.active {
    background-color: var(--rojo);
    border-color: var(--rojo);
    color: #ffffff;
  }

  /* Llamado a la acción principal */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 24px;
    border-radius: 6px;
    background-color: var(--rojo);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cta:hover {
    background-color: var(--negro);
    color: #ffffff;
  }

  /* Entrada al hacer scroll: sube 24px y aparece, con la curva de ZUN. */
  .js .reveal {
    opacity: 0;
    transform: translateY(24px);
  }

  .js .reveal.is-visible {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .js .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
