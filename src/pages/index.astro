---
import Base from '../layouts/Base.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Ticker from '../components/Ticker.astro';

// El correo es público: aparece en cada enlace de contacto de la página.
const contactEmail = import.meta.env.CONTACT_EMAIL || 'fabian.jeldes@gmail.com';
const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;

const buildMailto = (subject: string, body?: string) => {
  const params = new URLSearchParams();
  params.set('subject', subject);
  if (body) params.set('body', body);
  return `mailto:${contactEmail}?${params.toString().replace(/\+/g, '%20')}`;
};

const directMailto = buildMailto(
  'Hola Fabián — conversemos',
  'Hola Fabián,\n\nTe escribo porque me gustaría conversar sobre:\n\nNombre o empresa: \nContexto breve: \n'
);

const pillars = [
  {
    num: '01',
    title: 'Desarrollo web y plataformas',
    summary:
      'Diseño y construyo sitios rápidos, migraciones desde WordPress y aplicaciones web con arquitectura mantenible, foco en rendimiento y SEO técnico.',
    evidence: [
      'Migración editorial de Revista ZUN a Astro + Strapi en Cloudflare.',
      'Sitios en producción orientados a conversión para servicios profesionales.',
      'Interfaces modulares con Vue 3 (Composition API), Astro y APIs REST.',
    ],
    stack: ['Astro', 'Vue 3', 'JavaScript ES6+', 'Tailwind CSS', 'Strapi', 'Supabase', 'PostgreSQL', 'Cloudflare'],
  },
  {
    num: '02',
    title: 'Datos, automatización e IA',
    summary:
      'Ordeno y depuro bases de datos de gran volumen, automatizo flujos de limpieza para reportes ejecutivos y audito código y respuestas de modelos de lenguaje.',
    evidence: [
      'Consolidación y automatización en Excel y Python para auditoría de RR.HH. en ENGIE Chile.',
      'Curación de datasets bilingües y QA técnico de código para LLMs en Outlier Latam.',
      'Certificación Google en Analítica de Datos Avanzada y Análisis de Datos.',
    ],
    stack: ['Python', 'pandas', 'NumPy', 'scikit-learn', 'SQL', 'R', 'Excel avanzado', 'QA de LLMs'],
  },
  {
    num: '03',
    title: 'Infraestructura, seguridad y gestión',
    summary:
      'Acompaño proyectos de punta a punta: control de accesos, despliegue confiable, soporte técnico y traducción clara entre negocio y tecnología en español o inglés.',
    evidence: [
      'Diseño con control de roles (RBAC/RLS), buenas prácticas OWASP y Google Cybersecurity.',
      'Soporte TI independiente (Linux/Windows, diagnóstico y optimización) desde 2019.',
      'Gestión ágil (Scrum/Kanban) y producción bilingüe para marcas corporativas.',
    ],
    stack: ['RBAC / RLS', 'OWASP', 'Linux', 'Git / GitHub', 'Scrum', 'Kanban', 'Inglés C1–C2'],
  },
];

const webProjects = [
  {
    slug: 'zun',
    code: '01',
    shortLabel: 'Revista ZUN',
    category: 'web',
    name: 'Revista ZUN',
    kind: 'Plataforma editorial',
    url: 'https://revistazun.com',
    domain: 'revistazun.com',
    stack: 'Astro · Strapi · Cloudflare',
    text: 'Migración desde WordPress a un sitio rápido en Astro con CMS Strapi a la medida de la redacción, newsletter y donaciones.',
  },
  {
    slug: 'ayr',
    code: '02',
    shortLabel: 'A&R Legal',
    category: 'web',
    name: 'Arriaza & Ramírez Asociados',
    kind: 'Estudio jurídico',
    url: 'https://ayrlegal.cl',
    domain: 'ayrlegal.cl',
    stack: 'Web institucional · SEO · Conversión',
    text: 'Sitio rápido y claro para un estudio de derecho laboral, civil y de familia, estructurado para facilitar el agendamiento.',
  },
  {
    slug: 'psandrei',
    code: '03',
    shortLabel: 'Ps. Andrei',
    category: 'web',
    name: 'Ps. Andrei Andrusco',
    kind: 'Consulta clínica',
    url: 'https://psandrei.com',
    domain: 'psandrei.com',
    stack: 'Web profesional · Contenido · Agenda',
    text: 'Plataforma de consulta psicológica con artículos de psicoeducación, lectura cómoda en móvil y reserva de horas.',
  },
];

const technicalProjects = [
  {
    category: 'datos',
    meta: 'Datos & Automatización / 2024–2025',
    org: 'ENGIE Chile',
    title: 'Auditoría de RR.HH. y limpieza automatizada de datos',
    problem: 'Bases de datos de gran volumen con inconsistencias operativas y cruces manuales propensos a error.',
    solution:
      'Consolidé y depuré los registros críticos, automatizando flujos de limpieza en Excel y Python para habilitar reportes ejecutivos confiables.',
    stack: 'Python · Excel avanzado · Limpieza ETL · Control de inconsistencias',
  },
  {
    category: 'datos',
    meta: 'Software & Producto / 2026',
    org: 'Proyecto Integrado INACAP',
    title: 'Sistema de gestión y distribución de agua purificada',
    problem: 'Un negocio real de reparto necesitaba ordenar pedidos, rutas y operación sin sobredimensionar la inversión inicial.',
    solution:
      'Levanté requerimientos directo con el cliente y definimos en equipo un roadmap ejecutable en tres fases: MVP operativo, control logístico y autoservicio.',
    stack: 'Modelado relacional · SQL · Levantamiento · Roadmap MVP · Scrum',
  },
  {
    category: 'ia',
    meta: 'IA & Calidad / 2019–Presente',
    org: 'Outlier Latam',
    title: 'Curación de datasets y auditoría técnica de LLMs (EN/ES)',
    problem: 'Los modelos de lenguaje requieren evaluación rigurosa para evitar errores de lógica, código defectuoso o sesgos terminológicos.',
    solution:
      'Curo datos bilingües y audito código y respuestas generadas por IA bajo criterios estrictos de precisión técnica, consistencia y calidad lingüística.',
    stack: 'LLMs · Auditoría de código · Lingüística computacional · Bilingüe EN/ES',
  },
];

const experience = [
  {
    period: '2019 – Presente',
    role: 'Curación de Datos y Lingüística Computacional',
    org: 'Outlier Latam (freelance)',
    detail: 'Entrenamiento y evaluación bilingüe (EN/ES) de LLMs, auditoría de código y control de calidad de respuestas.',
  },
  {
    period: 'Sep 2024 – Feb 2025',
    role: 'Asistente de Análisis de Datos — Auditoría de RR.HH.',
    org: 'ENGIE Chile',
    detail: 'Depuración de bases masivas, detección de inconsistencias operativas y automatización en Excel y Python.',
  },
  {
    period: '2019 – Presente',
    role: 'Técnico de Soporte e Infraestructura TI',
    org: 'Consultoría independiente',
    detail: 'Diagnóstico, mantenimiento preventivo, optimización y configuración de equipos y sistemas Linux/Windows.',
  },
  {
    period: '2019',
    role: 'Productor Operativo Bilingüe',
    org: 'Nestlé · Metso Minería (Expomin)',
    detail: 'Coordinación de montajes corporativos, proveedores técnicos y asistencia directa en inglés a directivos internacionales.',
  },
];

const credentials = [
  {
    period: '2024 – 2026',
    title: 'Analista Programador',
    org: 'INACAP · Último semestre',
    detail: 'Desarrollo full-stack, bases de datos relacionales, ingeniería de software y proyecto aplicado con cliente real.',
  },
  {
    period: '2025 – 2026',
    title: 'Certificados Profesionales de Google (2× Beca Talento Digital)',
    org: 'Analítica Avanzada · Análisis de Datos · Gestión de Proyectos · Cybersecurity (en curso)',
    detail: 'Python, pandas, scikit-learn, SQL, R, Scrum/Kanban, gestión de riesgos y fundamentos de seguridad.',
  },
  {
    period: '2025',
    title: 'Bootcamp de Programación Front-End',
    org: 'Talento Digital',
    detail: 'Desarrollo de interfaces modernas, JavaScript ES6+, Vue 3 y buenas prácticas de componentes.',
  },
  {
    period: 'Idiomas y comunicación',
    title: 'Inglés C1–C2 · Coaching Integrativo · Producción de Eventos',
    org: 'CEFR (Chileno-Norteamericano) · Smart Coach · U. del Pacífico',
    detail: 'Fluidez bilingüe escrita y hablada, facilitación con equipos no técnicos y levantamiento claro de requerimientos.',
  },
];

const modes = [
  {
    num: '01',
    name: 'Sitios web y CMS',
    audience: 'Para medios, marcas y profesionales',
    summary: 'Sitios rápidos en Astro o Vue 3, migraciones desde WordPress y paneles editoriales en Strapi fáciles de usar.',
    features: [
      'Diseño editorial limpio y rendimiento móvil',
      'CMS a medida sin depender de plugins frágiles',
      'Opción de cuota mensual fija para medios independientes',
    ],
    featured: false,
    actionLabel: 'Ver planes para medios →',
    actionHref: '/medios',
    secondaryTopic: 'Sitio web / CMS',
  },
  {
    num: '02',
    name: 'Datos, automatización y software',
    audience: 'Para empresas, pymes y operaciones',
    summary: 'Ordeno bases de datos, automatizo reportes repetitivos en Python/SQL y construyo herramientas web a la medida.',
    features: [
      'Limpieza y consolidación de datos (Python, SQL, Excel)',
      'Backends, APIs REST y modelado en PostgreSQL / Supabase',
      'Levantamiento de requerimientos y entregas por etapas',
    ],
    featured: true,
    actionLabel: 'Cotizar un proyecto',
    actionHref: '#contacto',
    topic: 'Datos / Automatización',
  },
  {
    num: '03',
    name: 'Equipos técnicos y roles TI',
    audience: 'Analista Programador · Full-Stack · Datos',
    summary: 'Disponible para integrarme a equipos de producto, ingeniería o analítica en modalidad remota o híbrida en Santiago.',
    features: [
      'Perfil híbrido: código limpio + criterio analítico',
      'Trabajo fluido en español e inglés (CEFR C1–C2)',
      'Documentación clara y trato directo con áreas de negocio',
    ],
    featured: false,
    actionLabel: 'Conversemos sobre un rol',
    actionHref: '#contacto',
    topic: 'Oportunidad laboral',
  },
];

const contactTopics = [
  {
    id: 'Sitio web / CMS',
    placeholder: 'Ej: Queremos renovar nuestro sitio o migrar desde WordPress (https://...)',
  },
  {
    id: 'Datos / Automatización',
    placeholder: 'Ej: Necesitamos automatizar reportes en Python/Excel o depurar una base de datos',
  },
  {
    id: 'Oportunidad laboral',
    placeholder: 'Ej: Rol de Analista Programador / Data Analyst / Full-Stack (equipo y modalidad)',
  },
  {
    id: 'Auditoría de sitio',
    placeholder: 'Ej: URL del sitio que quieres revisar (https://...)',
  },
];
---

<Base
  title="Fabián Jeldes — Desarrollo Web, Software y Análisis de Datos"
  description="Analista Programador y Especialista en Datos. Sitios rápidos en Astro y Vue 3, CMS Strapi, automatización en Python/SQL y QA bilingüe de IA (EN/ES)."
>
  <!-- Barra de navegación superior -->
  <header class="topbar">
    <div class="topbar-inner">
      <a href="#" class="topbar-brand">
        <span class="topbar-dot" aria-hidden="true"></span>
        <span class="topbar-name">Fabián Jeldes</span>
        <span class="topbar-role">/ Software, Web y Datos</span>
      </a>
      <nav class="topbar-nav" aria-label="Navegación principal">
        <a href="#capacidades" class="pill topbar-pill">Qué hago</a>
        <a href="#proyectos" class="pill topbar-pill">Proyectos</a>
        <a href="#trayectoria" class="pill topbar-pill">Trayectoria</a>
        <a href="/medios" class="pill topbar-pill">Oferta medios</a>
        <a href="#contacto" class="pill topbar-pill pill--filled">Contacto</a>
      </nav>
    </div>
  </header>

  <!-- Hero con propuesta integral y selector interactivo de capturas -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="label reveal">* Analista Programador · Desarrollo Web · Análisis de Datos</p>
      <h1 class="reveal" style="--delay: 80ms">Desarrollo web, software y datos ordenados de punta a punta</h1>
      <p class="lead reveal" style="--delay: 160ms">
        Construyo sitios rápidos, sistemas a medida y flujos de datos en Python y SQL. Trabajo en español e inglés
        (C1–C2), desde la arquitectura técnica hasta la entrega con el equipo.
      </p>
      <div class="hero-actions reveal" style="--delay: 240ms">
        <a class="cta" href="#contacto">Conversemos</a>
        <a class="pill" href="#proyectos">Ver proyectos</a>
        <a class="pill" href="/medios">Oferta para medios →</a>
        <button
          type="button"
          class="pill copy-email-btn"
          data-copy-email={contactEmail}
          aria-label="Copiar correo de contacto directo"
        >
          <span class="copy-text">Copiar correo</span>
          <span class="copy-feedback" aria-live="polite">¡Correo copiado!</span>
        </button>
      </div>
      <ul class="hero-facts reveal" style="--delay: 300ms" aria-label="Datos rápidos de perfil">
        <li>Santiago, Chile · Remoto</li>
        <li>Español &amp; Inglés C1–C2</li>
        <li>2× Beca Google – Talento Digital</li>
      </ul>
    </div>

    <div class="hero-showcase-wrap reveal" style="--delay: 200ms">
      <div class="showcase-tabs" role="tablist" aria-label="Cambiar proyecto destacado">
        {
          webProjects.map((project, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              class:list={['showcase-tab', { active: idx === 0 }]}
              data-showcase-tab={project.slug}
              data-domain={project.domain}
              data-desktop={`/media/trabajos/${project.slug}-desktop.jpg`}
              data-mobile={`/media/trabajos/${project.slug}-mobile.jpg`}
              data-alt={`Sitio de ${project.name}`}
              data-stack={project.stack}
              data-kind={project.kind}
              data-url={project.url}
              data-name={project.name}
            >
              {project.code} {project.shortLabel}
            </button>
          ))
        }
      </div>

      <div class="hero-showcase" id="hero-showcase">
        <BrowserFrame
          src="/media/trabajos/zun-desktop.jpg"
          alt="Sitio de Revista ZUN"
          domain="revistazun.com"
          eager
        />
        <div class="hero-phone">
          <PhoneFrame src="/media/trabajos/zun-mobile.jpg" alt="Revista ZUN en el celular" eager />
        </div>
      </div>

      <div class="showcase-caption">
        <span id="showcase-stack" class="showcase-stack">Astro · Strapi · Cloudflare</span>
        <a
          id="showcase-link"
          class="showcase-link"
          href="https://revistazun.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver sitio ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Marquesina continua con el rango completo de capacidades -->
  <Ticker
    items={[
      'Astro & Vue 3',
      'Strapi CMS',
      'PostgreSQL & Supabase',
      'Python & Análisis de Datos',
      'Auditoría IA (EN/ES)',
      'Seguridad & Infraestructura',
      'Scrum & Kanban',
    ]}
  />

  <main>
    <!-- 01 / Qué hago: 3 pilares ordenados -->
    <section id="capacidades" class="wrap">
      <p class="label reveal">* 01 / Qué hago</p>
      <h2 class="reveal">Tres áreas que se conectan en un mismo sistema</h2>
      <p class="section-lead reveal">
        En lugar de habilidades sueltas, combino interfaz, datos e infraestructura para resolver problemas reales sin
        dependencias opacas.
      </p>
      <div class="pillars">
        {
          pillars.map((pillar, i) => (
            <div class="reveal" style={`--delay: ${i * 90}ms`}>
              <article class="pillar-card">
                <p class="label">{pillar.num}</p>
                <h3>{pillar.title}</h3>
                <p class="pillar-summary">{pillar.summary}</p>
                <ul class="rule-list hover-list pillar-list">
                  {pillar.evidence.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <ul class="stack-tags" aria-label={`Tecnologías de ${pillar.title}`}>
                  {pillar.stack.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
              </article>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 02 / Proyectos y experiencia aplicada (Visual + Técnico + Filtros) -->
    <section id="proyectos" class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="label">* 02 / Proyectos y experiencia aplicada</p>
          <h2>Sitios en producción y trabajo técnico</h2>
        </div>
        <div class="filter-bar" role="group" aria-label="Filtrar proyectos por área">
          <button type="button" class="pill filter-pill active" data-filter="all">Todos</button>
          <button type="button" class="pill filter-pill" data-filter="web">Web &amp; CMS</button>
          <button type="button" class="pill filter-pill" data-filter="datos">Datos &amp; Software</button>
          <button type="button" class="pill filter-pill" data-filter="ia">IA &amp; Calidad</button>
        </div>
      </div>

      <!-- Grupo visual: sitios web en producción -->
      <div class="project-group" data-group="web">
        <p class="label group-label">Sitios web en producción</p>
        <div class="projects">
          {
            webProjects.map((project, i) => (
              <div class="reveal filter-item" data-category={project.category} style={`--delay: ${i * 90}ms`}>
                <a class="project" href={project.url} target="_blank" rel="noopener noreferrer">
                  <div class="project-media">
                    <BrowserFrame
                      src={`/media/trabajos/${project.slug}-desktop.jpg`}
                      alt={`Sitio de ${project.name}`}
                      domain={project.domain}
                    />
                    <div class="project-phone">
                      <PhoneFrame
                        src={`/media/trabajos/${project.slug}-mobile.jpg`}
                        alt={`${project.name} en el celular`}
                      />
                    </div>
                  </div>
                  <p class="project-meta">
                    {project.kind} / {project.domain}
                  </p>
                  <h3>{project.name}</h3>
                  <p class="project-text">{project.text}</p>
                  <p class="project-stack">{project.stack}</p>
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Grupo técnico: fichas blueprint para proyectos de datos, software e IA -->
      <div class="project-group project-group--tech" data-group="technical">
        <p class="label group-label">Datos, arquitectura e inteligencia artificial</p>
        <div class="blueprints">
          {
            technicalProjects.map((item, i) => (
              <div class="reveal filter-item" data-category={item.category} style={`--delay: ${i * 90}ms`}>
                <article class="blueprint-card">
                  <p class="blueprint-meta">{item.meta}</p>
                  <p class="blueprint-org">{item.org}</p>
                  <h3>{item.title}</h3>
                  <div class="blueprint-body">
                    <p>
                      <strong>Desafío:</strong> {item.problem}
                    </p>
                    <p>
                      <strong>Enfoque:</strong> {item.solution}
                    </p>
                  </div>
                  <p class="blueprint-stack">{item.stack}</p>
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Caso Destacado: Revista ZUN (Astro + Strapi) -->
    <section id="caso-zun" class="case">
      <div class="wrap">
        <p class="label reveal">* Caso destacado / Arquitectura editorial</p>
        <img class="wordmark reveal" src="/zun-wordmark.svg" alt="Revista ZUN" width="1392" height="199" />
        <h2 class="reveal">De WordPress a una plataforma editorial a la medida</h2>
        <p class="case-note reveal">
          Esta misma página usa el sistema de diseño editorial que construimos para la revista.
        </p>

        <dl class="case-specs reveal">
          <div>
            <dt>Stack</dt>
            <dd>Astro + Strapi</dd>
          </div>
          <div>
            <dt>Distribución</dt>
            <dd>Cloudflare estático</dd>
          </div>
          <div>
            <dt>Autonomía</dt>
            <dd>Portada y notas sin código</dd>
          </div>
        </dl>

        <div class="case-grid">
          <div class="reveal">
            <h3>El punto de partida</h3>
            <p>
              Una revista digital frenada por WordPress, con plugins difíciles de mantener, tiempos de carga lentos en
              móvil y poco control sobre su identidad visual.
            </p>
            <p>
              Asumí la arquitectura completa: sistema de diseño en código, frontend en Astro, modelado de colecciones en
              Strapi, migración de archivo y salida a producción.
            </p>
          </div>
          <div class="reveal" style="--delay: 100ms">
            <h3>Lo que construimos</h3>
            <ul class="rule-list hover-list">
              <li>Sitio rápido en Astro, compilado y servido desde la red global de Cloudflare.</li>
              <li>CMS Strapi con formularios estructurados exactamente como trabaja la redacción.</li>
              <li>Migración completa de notas, autores, categorías e imágenes existentes.</li>
              <li>Newsletter y donaciones integradas en cada artículo sin herramientas parcheadas.</li>
              <li>Portada, especiales y convocatorias editables desde el CMS, sin tocar código.</li>
            </ul>
          </div>
        </div>

        <blockquote class="case-quote reveal">
          <p>
            "Pasamos de tener miedo a tocar WordPress por si algo se rompía, a tener una redacción que publica notas
            completas con fotos y newsletter en minutos. El sitio vuela desde el teléfono y la identidad visual se siente
            por fin como una revista de verdad."
          </p>
          <cite>— Equipo editorial de Revista ZUN</cite>
        </blockquote>

        <div class="case-actions reveal">
          <a class="pill" href="https://revistazun.com" target="_blank" rel="noopener noreferrer">
            Visita revistazun.com ↗
          </a>
          <a class="pill pill--filled" href="/medios">
            ¿Tienes un medio? Ver planes mensuales →
          </a>
        </div>
      </div>
    </section>

    <!-- 03 / Trayectoria y credenciales -->
    <section id="trayectoria" class="wrap">
      <p class="label reveal">* 03 / Trayectoria y credenciales</p>
      <h2 class="reveal">Experiencia, formación y cómo se complementan</h2>
      <p class="section-lead reveal">
        Combino formación técnica en programación y datos con años de trabajo directo en operaciones, soporte y trato
        con clientes en dos idiomas.
      </p>

      <div class="resume-grid">
        <div class="reveal">
          <p class="label resume-col-label">Experiencia aplicada</p>
          <ul class="rule-list hover-list resume-list">
            {
              experience.map((item) => (
                <li>
                  <p class="resume-period">{item.period}</p>
                  <h4>{item.role}</h4>
                  <p class="resume-org">{item.org}</p>
                  <p class="resume-detail">{item.detail}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal" style="--delay: 100ms">
          <p class="label resume-col-label">Formación, becas e idiomas</p>
          <ul class="rule-list hover-list resume-list">
            {
              credentials.map((item) => (
                <li>
                  <p class="resume-period">{item.period}</p>
                  <h4>{item.title}</h4>
                  <p class="resume-org">{item.org}</p>
