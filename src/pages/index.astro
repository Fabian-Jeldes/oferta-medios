    </div>
  </footer>

  <!-- Interactividad ligera sin dependencias: Hero showcase, filtros, copia de correo y contacto inteligente -->
  <script is:inline>
    // 1. Selector de proyecto destacado en el Hero
    const showcaseTabs = document.querySelectorAll('[data-showcase-tab]');
    const heroShowcase = document.getElementById('hero-showcase');
    const showcaseStack = document.getElementById('showcase-stack');
    const showcaseLink = document.getElementById('showcase-link');

    if (heroShowcase && showcaseTabs.length) {
      const desktopImg = heroShowcase.querySelector('.browser-screen img');
      const domainLabel = heroShowcase.querySelector('.browser-bar .address');
      const mobileImg = heroShowcase.querySelector('.phone img');

      showcaseTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          showcaseTabs.forEach((t) => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');

          const desktopSrc = tab.getAttribute('data-desktop');
          const mobileSrc = tab.getAttribute('data-mobile');
          const domain = tab.getAttribute('data-domain');
          const alt = tab.getAttribute('data-alt');
          const stack = tab.getAttribute('data-stack');
          const url = tab.getAttribute('data-url');

          if (desktopImg && desktopSrc) {
            desktopImg.src = desktopSrc;
            if (alt) desktopImg.alt = alt;
          }
          if (mobileImg && mobileSrc) {
            mobileImg.src = mobileSrc;
            if (alt) mobileImg.alt = `${alt} en el celular`;
          }
          if (domainLabel && domain) domainLabel.textContent = domain;
          if (showcaseStack && stack) showcaseStack.textContent = stack;
          if (showcaseLink && url) showcaseLink.setAttribute('href', url);
        });
      });
    }

    // 2. Filtros de proyectos
    const filterButtons = document.querySelectorAll('[data-filter]');
    const filterItems = document.querySelectorAll('.filter-item');
    const projectGroups = document.querySelectorAll('.project-group');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-filter') || 'all';
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        filterItems.forEach((item) => {
          const cat = item.getAttribute('data-category');
          const match = selected === 'all' || cat === selected;
          item.hidden = !match;
          if (match) item.classList.add('is-visible');
        });

        projectGroups.forEach((group) => {
          const visibleChildren = group.querySelectorAll('.filter-item:not([hidden])').length;
          group.hidden = visibleChildren === 0;
        });
      });
    });

    // 3. Copiar correo al portapapeles
    document.querySelectorAll('[data-copy-email]').forEach((button) => {
      button.addEventListener('click', async () => {
        const email = button.getAttribute('data-copy-email');
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
        } catch (err) {
          const input = document.createElement('input');
          input.value = email;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }

        button.classList.add('copied');
        setTimeout(() => {
          button.classList.remove('copied');
        }, 2500);
      });
    });

    // 4. Selector de motivo y formulario de contacto
    const topicPills = document.querySelectorAll('[data-topic]');
    const topicInput = document.getElementById('contact-topic');
    const contextInput = document.getElementById('contact-context');

    const setTopic = (topicName) => {
      let matched = null;
      topicPills.forEach((pill) => {
        const isMatch = pill.getAttribute('data-topic') === topicName;
        pill.classList.toggle('active', isMatch);
        if (isMatch) matched = pill;
      });
      if (matched) {
        if (topicInput) topicInput.value = topicName;
        const placeholder = matched.getAttribute('data-placeholder');
        if (contextInput && placeholder) contextInput.placeholder = placeholder;
      }
    };

    topicPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const topic = pill.getAttribute('data-topic');
        if (topic) setTopic(topic);
      });
    });

    document.querySelectorAll('[data-select-topic]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const topic = trigger.getAttribute('data-select-topic');
        if (topic) setTopic(topic);
      });
    });

    const contactForm = document.getElementById('contact-form');
    const contactFeedback = document.getElementById('contact-feedback');
    const feedbackPreview = document.getElementById('feedback-preview');
    const feedbackMailtoLink = document.getElementById('feedback-mailto-link');
    const copyMsgBtn = document.getElementById('copy-msg-btn');

    if (contactForm) {
      const contactEmail = contactForm.getAttribute('data-contact-email') || '';

      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameInput = document.getElementById('contact-name');
        const emailInput = document.getElementById('contact-email');
        const topic = (topicInput?.value || 'Consulta general').trim();
        const name = (nameInput?.value || '').trim();
        const email = (emailInput?.value || '').trim();
        const context = (contextInput?.value || '').trim();

        if (!name || !email || !context) {
          if (!name && nameInput) nameInput.focus();
          else if (!email && emailInput) emailInput.focus();
          else if (!context && contextInput) contextInput.focus();
          return;
        }

        const subject = `[${topic}] ${name}`;
        const body = `Hola Fabián,

Te escribo desde tu sitio sobre: ${topic}.

* Nombre o empresa: ${name}
* Correo de respuesta: ${email}
* Contexto / URL: ${context}

Quedo atento para conversar.

Saludos,
${name}`;

        const mailtoUrl = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        if (feedbackPreview) feedbackPreview.textContent = body;
        if (feedbackMailtoLink) feedbackMailtoLink.href = mailtoUrl;
        if (contactFeedback) {
          contactFeedback.hidden = false;
          contactFeedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        window.location.href = mailtoUrl;
      });

      if (copyMsgBtn && feedbackPreview) {
        copyMsgBtn.addEventListener('click', async () => {
          const text = feedbackPreview.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            copyMsgBtn.classList.add('copied');
            setTimeout(() => {
              copyMsgBtn.classList.remove('copied');
            }, 2500);
          } catch (e) {
            // Ignorar si no hay permisos de portapapeles
          }
        });
      }
    }
  </script>
</Base>

